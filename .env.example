# Database (SQLite file path, no server needed)
DATABASE_URL=./data/woebegone.db

# Server
PORT=3000
NODE_ENV=development

# Optional: Redis for background jobs (BullMQ)
# REDIS_URL=redis://localhost:6379

# Optional: External API keys for data collection
# ETHERSCAN_API_KEY=
# COINGECKO_API_KEY=
# CER_LIVE_API_KEY=
# INFURA_URL=
# PRIVATE_KEY=
# IPFS_API_KEY=

# Web search — used by the real-time auditor to discover security info
# At least one recommended for full auditing capability
# EXA_API_KEY=
# BRAVE_SEARCH_API_KEY=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=
